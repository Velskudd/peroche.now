@inject NavigationManager Navigation

<header class="entete conteneur">
    <a class="entete__marque" href="/" aria-label="peroche.now, accueil">
        <svg width="34" height="34" aria-hidden="true"><use href="#ap15" width="34" height="34"></use></svg>
        <span class="entete__nom">peroche.now</span>
    </a>

    <nav class="entete__nav" aria-label="Navigation principale">
        @foreach (var destination in PlanDuSite.Menu)
        {
            @if (PlanDuSite.EstCourante(destination, cheminCourant))
            {
                <a href="@destination.Adresse" aria-current="page">@destination.Libelle</a>
            }
            else
            {
                <a href="@destination.Adresse">@destination.Libelle</a>
            }
        }
    </nav>
</header>

@code {
    private string cheminCourant = string.Empty;

    protected override void OnInitialized() =>
        cheminCourant = Navigation.ToBaseRelativePath(Navigation.Uri);
}
