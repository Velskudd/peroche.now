@inject IHorloge Horloge

@* Les quatre saisons de NUR24 ; les années atteintes sont pleines, l'objectif est en or. *@
<ol class="saisons" aria-label="Les saisons de NUR24">
    @foreach (var saison in Liste)
    {
        <li class="@Classes(saison)">
            <span class="saison__barre" aria-hidden="true"></span>
            <span class="saison__annee">@saison.Annee</span>
            <span class="saison__etape">@Textes.Element(TextesAccueil.Saisons, saison.Position)</span>
        </li>
    }
</ol>

@code {
    // Les années restent dans le code (elles décident de ce qui est atteint) ; les étapes se modifient dans l'administration.
    private sealed record Saison(int Annee, int Position, bool EstLeBut = false);

    private static readonly Saison[] Liste =
    [
        new(2026, 0),
        new(2027, 1),
        new(2028, 2),
        new(2029, 3, EstLeBut: true),
    ];

    private string Classes(Saison saison)
    {
        var classes = "saison";
        if (saison.Annee <= Horloge.Instant.Year) classes += " saison--atteinte";
        if (saison.EstLeBut) classes += " saison--but";
        return classes;
    }
}
