@page "/nur24"
@using PerocheNow.Web.Circuits
@using PerocheNow.Web.Contenus
@inject IHorloge Horloge

<PageTitle>@Textes[TextesNur24.Onglet]</PageTitle>
<HeadContent>
    <meta name="description" content="@Textes[TextesNur24.Description]" />
</HeadContent>

<section class="nur-tete conteneur" aria-labelledby="nur24">
    <div class="nur-tete__texte">
        <p class="projet__contexte">@Textes[TextesNur24.Contexte]</p>
        <h1 id="nur24" class="projet__nom nur-tete__nom">@Textes[TextesNur24.Nom]</h1>
        <p class="projet__promesse">@Textes[TextesNur24.Promesse]</p>
        <p class="nur-tete__intro">@Textes[TextesNur24.Intro]</p>
    </div>
    <CircuitInteractif Identifiant="route"
                       Etapes="EtapesDuProjet.Route(Textes, Horloge, Medias, Assets)"
                       Titre="@Textes[TextesNur24.RouteTitre]"
                       Legende="@Textes[TextesNur24.Legende]"
                       EtiquetteEnCours="@Textes[TextesNur24.RouteIci]"
                       EtiquetteObjectif="@Textes[TextesNur24.RouteObjectif]" />
</section>

<section class="parcours conteneur" aria-labelledby="parcours">
    <div class="parcours__interieur">
        <div class="parcours__tete">
            <h2 id="parcours" class="titre-section">@Textes[TextesNur24.ParcoursTitre]</h2>
            <p>@Textes[TextesNur24.ParcoursIntro]</p>
        </div>
        <CircuitInteractif Identifiant="parcours"
                           Etapes="EtapesDuProjet.Parcours(Textes, Medias, Assets)"
                           Legende="@Textes[TextesNur24.ParcoursLegende]"
                           EtiquetteEnCours="@Textes[TextesNur24.RouteIci]" />
    </div>
</section>

<section class="bande" aria-labelledby="ou-jen-suis">
    <div class="bande__interieur conteneur ou-jen-suis">
        <h2 id="ou-jen-suis" class="titre-section ou-jen-suis__titre">@Textes[TextesNur24.OuTitre]</h2>
        <div class="ou-jen-suis__texte">
            <p class="ou-jen-suis__phrase">@Textes[TextesNur24.OuPhrase]</p>
            <p class="objectif objectif--statique">
                <span class="objectif__etiquette">@Textes[TextesNur24.OuEtiquette]</span>
                <span class="objectif__libelle">@Textes[TextesNur24.OuEtape]</span>
                <span class="objectif__date">@Textes[TextesNur24.OuDate]</span>
            </p>
            @if (VideoYouTube.Lire(Textes[TextesNur24.OuVlogAdresse]) is { } vlog)
            {
                <a class="vlog" href="@vlog.Lien">
                    <span class="vlog__vignette">
                        <img src="@vlog.Miniature" srcset="@($"{vlog.Miniature} 320w, {vlog.MiniatureHauteDefinition} 1280w")" sizes="176px"
                             width="176" height="99" alt="" loading="lazy" decoding="async" />
                        <svg class="vlog__lecture" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
                    </span>
                    <span class="vlog__texte">
                        <span class="vlog__etiquette">@Textes[TextesNur24.OuVlogEtiquette]</span>
                        <span class="vlog__titre">@Textes[TextesNur24.OuVlogTitre]</span>
                    </span>
                </a>
            }
        </div>
        <figure class="ou-jen-suis__photo">
            <PhotoDuSite Emplacement="CatalogueDesMedias.Nur24OuJenSuis" Repli="images/showroom.jpg"
                         Largeur="498" Hauteur="665" Chargement="lazy" />
        </figure>
    </div>
</section>

<section class="partenaires conteneur" aria-labelledby="partenaires-nur">
    <div class="partenaires__interieur">
        <div class="partenaires__texte">
            <h2 id="partenaires-nur" class="partenaires__titre">@Textes[TextesNur24.PartenairesTitre]</h2>
            <p>@Textes[TextesNur24.PartenairesTexte]</p>
        </div>
        <a class="bouton-objectif" href="@PlanDuSite.Partenaires.Adresse">@Textes[TextesNur24.PartenairesBouton]</a>
    </div>
</section>
