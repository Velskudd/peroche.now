@page "/liens"
@layout LayoutLiens
@inject LecteurDuMoment Lecteur
@inject IOptions<LiensOptions> Liens

<PageTitle>@Textes[TextesLiens.Onglet]</PageTitle>
<HeadContent>
    <meta name="description" content="@Textes[TextesLiens.Description]" />
</HeadContent>

<header class="liens__tete">
    <PhotoDuSite Emplacement="CatalogueDesMedias.LiensPhoto" Repli="images/volant-regard.jpg" Classe="liens__photo"
                 Largeur="665" Hauteur="831" Priorite="high" />
    <div class="liens__identite">
        <svg width="30" height="30" aria-hidden="true"><use href="#ap15" width="30" height="30"></use></svg>
        <h1 class="liens__nom">@Textes[TextesLiens.Nom]</h1>
        <p class="liens__devise">@Textes[TextesLiens.Devise]</p>
    </div>
</header>

<div class="liens__corps">
    <PastilleDirect />

    @if (statut is not null)
    {
        <a class="liens__carte" href="@PlanDuSite.Maintenant.Adresse">
            <span class="liens__etiquette">@Textes[TextesLiens.CarteEtiquette]</span>
            <span class="liens__accroche">@statut.Accroche</span>
            @if (statut.ProchainObjectif is { } objectif)
            {
                <span class="liens__objectif">
                    <span class="objectif__etiquette">@Textes[TextesLiens.CarteObjectif]</span>
                    <span>@objectif.Libelle</span>
                </span>
            }
            <span class="liens__vers">@Textes[TextesLiens.CarteVers]</span>
        </a>
    }

    @if (reseaux.Count > 0)
    {
        <h2 class="liens__groupe">@Textes[TextesLiens.GroupeReseaux]</h2>
        <ul class="liens__boutons">
            @foreach (var (nom, adresse) in reseaux)
            {
                <li><a class="liens__bouton" href="@adresse">@nom</a></li>
            }
        </ul>
    }

    <h2 class="liens__groupe">@Textes[TextesLiens.GroupeProjet]</h2>
    <ul class="liens__boutons">
        <li><a class="liens__bouton liens__bouton--projet" href="@PlanDuSite.ProjetEnCours.Adresse">@Textes[TextesLiens.BoutonProjet]</a></li>
        <li><a class="liens__bouton liens__bouton--objectif" href="@PlanDuSite.Partenaires.Adresse">@Textes[TextesLiens.BoutonPartenaire]</a></li>
    </ul>

    <footer class="liens__pied">
        <a href="@PlanDuSite.Maintenant.Adresse">
            <svg width="22" height="22" aria-hidden="true"><use href="#ap15" width="22" height="22"></use></svg>
            <span>peroche.now</span>
        </a>
    </footer>
</div>

@code {
    /// <summary>Ouverte depuis une bio, la page n'attend pas le réveil de la base : statut de secours au-delà.</summary>
    private static readonly TimeSpan AttenteCourte = TimeSpan.FromSeconds(3);

    private StatutDuMomentDto? statut;
    private List<(string Nom, string Adresse)> reseaux = [];

    protected override async Task OnInitializedAsync()
    {
        reseaux = Liens.Value.Reseaux().ToList();
        statut = await Lecteur.LireAsync(AttenteCourte);
    }
}
