@page "/partenaires"
@inject IOptions<LiensOptions> Liens

<PageTitle>@Textes[TextesPartenaires.Onglet]</PageTitle>
<HeadContent>
    <meta name="description" content="@Textes[TextesPartenaires.Description]" />
</HeadContent>

<section class="partenaires-tete conteneur" aria-labelledby="embarquer">
    <div class="partenaires-tete__texte">
        <h1 id="embarquer" class="partenaires-tete__titre">@Textes[TextesPartenaires.Titre]</h1>
        <p>@Textes[TextesPartenaires.Texte]</p>
        @if (aUnDossier || aUnContact)
        {
            <div class="actions">
                @if (aUnDossier)
                {
                    <a class="bouton-objectif" href="@Liens.Value.DossierPartenaire">@Textes[TextesPartenaires.BoutonDossier]</a>
                }
                @if (aUnContact)
                {
                    <a class="vers" href="mailto:@Liens.Value.ContactPartenariats">@Textes[TextesPartenaires.LienContact]</a>
                }
            </div>
        }
    </div>
    <figure class="partenaires-tete__photo">
        <PhotoDuSite Emplacement="CatalogueDesMedias.PartenairesPhoto" Repli="images/casque-bras-croises.jpg"
                     Largeur="532" Hauteur="665" Priorite="high" />
    </figure>
</section>

<section class="bande clair" aria-labelledby="pourquoi">
    <div class="bande__interieur conteneur">
        <h2 id="pourquoi" class="titre-section">@Textes[TextesPartenaires.PourquoiTitre]</h2>
        <div class="grille-trois">
            <div class="argument">
                <h3 class="argument__titre">@Textes[TextesPartenaires.Argument1Titre]</h3>
                <p>@Textes[TextesPartenaires.Argument1Texte]</p>
                <a class="vers" href="@PlanDuSite.ProjetEnCours.Adresse">@Textes[TextesPartenaires.Argument1Lien]</a>
            </div>
            <div class="argument">
                <h3 class="argument__titre">@Textes[TextesPartenaires.Argument2Titre]</h3>
                <p>@Textes[TextesPartenaires.Argument2Texte]</p>
                <a class="vers" href="@PlanDuSite.ProjetEnCours.Adresse">@Textes[TextesPartenaires.Argument2Lien]</a>
            </div>
            <div class="argument">
                <h3 class="argument__titre">@Textes[TextesPartenaires.Argument3Titre]</h3>
                <p>@Textes[TextesPartenaires.Argument3Texte]</p>
                <a class="vers" href="@PlanDuSite.Contenus.Adresse">@Textes[TextesPartenaires.Argument3Lien]</a>
            </div>
        </div>
    </div>
</section>

<section class="visibilite conteneur" aria-labelledby="visibilite">
    <h2 id="visibilite" class="titre-section">@Textes[TextesPartenaires.VisibiliteTitre]</h2>
    <ul class="grille-trois visibilite__liste">
        <li>
            <span class="visibilite__titre">@Textes[TextesPartenaires.Visibilite1Titre]</span>
            <span>@Textes[TextesPartenaires.Visibilite1Texte]</span>
        </li>
        <li>
            <span class="visibilite__titre">@Textes[TextesPartenaires.Visibilite2Titre]</span>
            <span>@Textes[TextesPartenaires.Visibilite2Texte]</span>
        </li>
        <li>
            <span class="visibilite__titre">@Textes[TextesPartenaires.Visibilite3Titre]</span>
            <span>@Textes[TextesPartenaires.Visibilite3Texte]</span>
        </li>
    </ul>
    <p class="visibilite__note">
        @Textes[TextesPartenaires.VisibiliteNote]
        @if (aUnDossier)
        {
            <text>@Textes[TextesPartenaires.VisibiliteNoteDossier]</text>
        }
    </p>
</section>

<section class="partenaires conteneur" aria-labelledby="contact">
    <div class="partenaires__interieur">
        <div class="partenaires__texte">
            <h2 id="contact" class="partenaires__titre">@Textes[TextesPartenaires.ContactTitre]</h2>
            <p>@Textes[TextesPartenaires.ContactTexte]</p>
            @if (aUnContact)
            {
                <a class="contact__adresse" href="mailto:@Liens.Value.ContactPartenariats">@Liens.Value.ContactPartenariats</a>
            }
            else
            {
                <p class="visibilite__note">@Textes[TextesPartenaires.ContactAttente]</p>
            }
        </div>
        @if (aUnDossier)
        {
            <a class="bouton-objectif" href="@Liens.Value.DossierPartenaire">@Textes[TextesPartenaires.BoutonDossier]</a>
        }
    </div>
</section>

@code {
    private bool aUnDossier => !string.IsNullOrWhiteSpace(Liens.Value.DossierPartenaire);
    private bool aUnContact => !string.IsNullOrWhiteSpace(Liens.Value.ContactPartenariats);
}
