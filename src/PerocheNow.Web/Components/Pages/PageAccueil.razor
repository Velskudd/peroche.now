@code {
    [CascadingParameter] private HttpContext? Contexte { get; set; }

    private string OgImage =>
        Contexte is null
            ? "images/combinaison-1040.jpg"
            : $"{Contexte.Request.Scheme}://{Contexte.Request.Host}/images/combinaison-1040.jpg";
}
