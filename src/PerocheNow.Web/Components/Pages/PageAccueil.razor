@page "/"

<PageTitle>@Textes[TextesAccueil.Onglet]</PageTitle>
<HeadContent>
    <meta name="description" content="@Textes[TextesAccueil.Description]" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@Textes[TextesAccueil.PartageTitre]" />
    <meta property="og:description" content="@Textes[TextesAccueil.PartageDescription]" />
    <meta property="og:image" content="@OgImage" />
    <meta property="og:locale" content="fr_FR" />
</HeadContent>

<EnCeMoment />
<ProjetEnCours />
<DerniersContenus />
<ACoteDeLaPiste />
<Partenaires />

@code {
    [CascadingParameter] private HttpContext? Contexte { get; set; }

    // Les réseaux veulent une adresse complète.
    private string OgImage
    {
        get
        {
            var chemin = (Medias.Adresse(CatalogueDesMedias.Partage, Assets) ?? string.Empty).TrimStart('/');
            return Contexte is null ? chemin : $"{Contexte.Request.Scheme}://{Contexte.Request.Host}/{chemin}";
        }
    }
}
