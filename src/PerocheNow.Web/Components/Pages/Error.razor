@page "/Error"
@using System.Diagnostics

<PageTitle>@Textes[TextesCommuns.ErreurOnglet]</PageTitle>

<section class="page-simple conteneur">
    <h1>@Textes[TextesCommuns.ErreurTitre]</h1>
    <p>@Textes[TextesCommuns.ErreurTexte]</p>
    <p><a href="/">@Textes[TextesCommuns.ErreurLien]</a></p>
    @if (!string.IsNullOrEmpty(reference))
    {
        <p class="reference">@Textes[TextesCommuns.ErreurReference] <code>@reference</code></p>
    }
</section>

@code {
    [CascadingParameter] private HttpContext? Contexte { get; set; }

    private string? reference;

    protected override void OnInitialized() =>
        reference = Activity.Current?.Id ?? Contexte?.TraceIdentifier;
}
