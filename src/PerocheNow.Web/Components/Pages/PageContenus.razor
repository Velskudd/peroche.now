@page "/contenus"
@using PerocheNow.Business.Contenus
@using PerocheNow.Web.Contenus
@inject IOptions<LiensOptions> Liens
@inject LecteurDeContenus Lecteur

<PageTitle>@Textes[TextesContenus.Onglet]</PageTitle>
<HeadContent>
    <meta name="description" content="@Textes[TextesContenus.Description]" />
</HeadContent>

<section class="page-tete conteneur" aria-labelledby="contenus-titre">
    <h1 id="contenus-titre" class="page-tete__titre">@Textes[TextesContenus.Titre]</h1>
    <p class="page-tete__intro">
        @Textes[TextesContenus.Intro]
        @if (!string.IsNullOrWhiteSpace(Liens.Value.Twitch))
        {
            <text>@Textes[TextesContenus.Lives] <a href="@Liens.Value.Twitch">@Textes[TextesContenus.LienTwitch]</a>.</text>
        }
    </p>
</section>

@if (videos.Count == 0 && courts.Count == 0 && instagram.Count == 0)
{
    <section class="conteneur page-corps" aria-label="Contenus indisponibles">
        <div class="chantier chantier--encadre">
            <p>@Textes[TextesContenus.Indisponible]</p>
            @if (reseaux.Count > 0)
            {
                <p class="chantier__reseaux">
                    @foreach (var (nom, adresse) in reseaux)
                    {
                        <a href="@adresse">@nom</a>
                    }
                </p>
            }
        </div>
    </section>
}
else
{
    <div class="conteneur page-corps galeries">
        @if (videos.Count > 0)
        {
            <section aria-labelledby="videos-titre">
                <div class="section-tete">
                    <h2 id="videos-titre" class="titre-section">@Textes[TextesContenus.VideosTitre]</h2>
                    @if (!string.IsNullOrWhiteSpace(Liens.Value.YouTube))
                    {
                        <a class="vers" href="@Liens.Value.YouTube">@Textes[TextesContenus.VideosLien]</a>
                    }
                </div>
                <div class="galerie-videos">
                    @foreach (var video in videos)
                    {
                        <CarteVideo Contenu="video" />
                    }
                </div>
            </section>
        }

        @if (instagram.Count > 0)
        {
            <section aria-labelledby="instagram-titre">
                <div class="section-tete">
                    <h2 id="instagram-titre" class="titre-section">@Textes[TextesContenus.InstagramTitre]</h2>
                    @if (!string.IsNullOrWhiteSpace(Liens.Value.Instagram))
                    {
                        <a class="vers" href="@Liens.Value.Instagram">@Textes[TextesContenus.InstagramLien]</a>
                    }
                </div>
                <div class="galerie-instagram">
                    @foreach (var publication in instagram)
                    {
                        <CarteInstagram Contenu="publication" />
                    }
                </div>
            </section>
        }

        @if (courts.Count > 0)
        {
            <section aria-labelledby="courts-titre">
                <div class="section-tete">
                    <h2 id="courts-titre" class="titre-section">@Textes[TextesContenus.CourtsTitre]</h2>
                </div>
                <div class="galerie-courts">
                    @foreach (var court in courts)
                    {
                        <CarteCourt Contenu="court" />
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    private List<Contenu> videos = [];
    private List<Contenu> courts = [];
    private List<Contenu> instagram = [];
    private List<(string Nom, string Adresse)> reseaux = [];

    protected override async Task OnInitializedAsync()
    {
        reseaux = Liens.Value.Reseaux().ToList();
        var contenus = await Lecteur.LireAsync();
        videos = contenus.Where(c => c.Format == FormatDeContenu.Video).Take(6).ToList();
        courts = contenus.Where(c => c.Format == FormatDeContenu.Court && c.Plateforme == Plateforme.YouTube).Take(10).ToList();
        instagram = contenus.Where(c => c.Plateforme == Plateforme.Instagram).Take(8).ToList();
    }
}
