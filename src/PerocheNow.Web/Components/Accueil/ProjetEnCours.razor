<section class="projet" aria-labelledby="projet-titre">
    <div class="projet__interieur conteneur">
        <div class="projet__texte">
            <p class="projet__contexte">@Textes[TextesAccueil.ProjetContexte]</p>
            <h2 id="projet-titre" class="projet__nom">@Textes[TextesAccueil.ProjetNom]</h2>
            <p class="projet__promesse">@Textes[TextesAccueil.ProjetPromesse]</p>
            <Saisons />
            <p class="projet__ou">@Textes[TextesAccueil.ProjetOu]</p>
            <a class="vers" href="@PlanDuSite.ProjetEnCours.Adresse">@Textes[TextesAccueil.ProjetLien]</a>
        </div>

        <TraceNordschleife Legende="@Textes[TextesAccueil.ProjetLegende]" />
    </div>
</section>
