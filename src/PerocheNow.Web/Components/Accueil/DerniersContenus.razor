@using PerocheNow.Business.Contenus
@using PerocheNow.Web.Contenus
@inject LecteurDeContenus Lecteur

<section class="contenus conteneur" aria-labelledby="contenus-titre">
    <div class="section-tete">
        <h2 id="contenus-titre" class="titre-section">@Textes[TextesAccueil.ContenusTitre]</h2>
        <a class="vers" href="@PlanDuSite.Contenus.Adresse">@Textes[TextesAccueil.ContenusLien]</a>
    </div>

    @if (video is null && courts.Count == 0)
    {
        <p class="chantier">@Textes[TextesAccueil.ContenusVide]</p>
    }
    else
    {
        <div class="contenus__grille">
            @if (video is not null)
            {
                <CarteVideo Contenu="video" />
            }
            @if (courts.Count > 0)
            {
                <div class="contenus__courts">
                    @foreach (var court in courts)
                    {
                        <CarteCourt Contenu="court" />
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private Contenu? video;
    private List<Contenu> courts = [];

    protected override async Task OnInitializedAsync()
    {
        var contenus = await Lecteur.LireAsync();
        video = contenus.FirstOrDefault(c => c.Format == FormatDeContenu.Video);
        // Les Reels reprennent les mêmes clips que les Shorts : l'accueil s'en tient à YouTube pour éviter les doublons.
        courts = contenus.Where(c => c.Format == FormatDeContenu.Court && c.Plateforme == Plateforme.YouTube).Take(3).ToList();
    }
}
