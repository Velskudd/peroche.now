@inject LecteurDuMoment Lecteur
@inject IHorloge Horloge

@if (statut is null)
{
    return;
}

@* L'ouverture : une vidéo filtrée en plein écran, l'heure, l'accroche et une seule action. Le reste attend en dessous. *@
<section class="ouverture" aria-labelledby="maintenant-titre">
    <div class="ouverture__media" aria-hidden="true">
        @* La vidéo n'est chargée par video-accueil.js que si le visiteur n'a demandé ni moins d'animations ni d'économiser ses données. *@
        <video class="ouverture__video" muted loop playsinline preload="none"
               poster="@Assets["images/accueil-poster.jpg"]"
               data-src="@Assets["videos/accueil.mp4"]"></video>
        <div class="ouverture__voile"></div>
    </div>

    <div class="ouverture__contenu conteneur">
        <p class="maintenant__heure" data-heure-paris data-suite="@Suite">@LigneHeure</p>
        <h1 id="maintenant-titre" class="ouverture__accroche">@statut.Accroche</h1>

        <div class="ouverture__actions">
            <a class="bouton-objectif" href="@PlanDuSite.ProjetEnCours.Adresse">Suivre le projet NUR24</a>
            <a class="vers" href="#en-ce-moment">Ce que je fais en ce moment</a>
        </div>
    </div>

    <div class="ouverture__pied conteneur">
        @if (statut.ProchainObjectif is { } objectif)
        {
            <a class="ouverture__objectif" href="@PlanDuSite.ProjetEnCours.Adresse">
                <span class="objectif__etiquette">Prochain objectif</span>
                <span class="objectif__libelle">@objectif.Libelle</span>
                <span class="objectif__date">@DateObjectif(objectif)</span>
            </a>
        }

        <button class="ouverture__pause" type="button" aria-pressed="false" hidden>Mettre la vidéo en pause</button>
    </div>
</section>

@if (statut.Lignes.Count > 0)
{
    <section id="en-ce-moment" class="en-ce-moment conteneur" aria-label="Ce que je fais en ce moment">
        <ul class="maintenant__lignes">
            @foreach (var ligne in statut.Lignes)
            {
                <li>
                    @if (PlanDuSite.Pour(ligne.Rubrique) is { } destination)
                    {
                        <a class="porte" href="@destination.Adresse">
                            <span class="porte__nom">@destination.Libelle</span>
                            <span>@ligne.Texte</span>
                        </a>
                    }
                    else
                    {
                        <span>@ligne.Texte</span>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    private const string Lieu = "en Bretagne";
    private static readonly string Suite = $" {Lieu}. Voici ce que je fais.";
    private static readonly CultureInfo Francais = CultureInfo.GetCultureInfo("fr-FR");

    private StatutDuMomentDto? statut;

    private string LigneHeure =>
        HeureDeParis.Formater(Horloge.Instant) is { } heure
            ? heure + Suite
            : $"En ce moment, {Lieu}. Voici ce que je fais.";

    protected override async Task OnInitializedAsync() => statut = await Lecteur.LireAsync();

    private static string DateObjectif(ObjectifDto objectif) =>
        objectif.DateCible is { } date ? date.ToString("d MMMM yyyy", Francais) : "Date à confirmer";
}
