@inject LecteurDuMoment Lecteur
@inject IHorloge Horloge
@inject IOptions<LiensOptions> Liens

@if (statut is null)
{
    return;
}

<section class="maintenant conteneur" aria-labelledby="maintenant-titre">
    <div class="maintenant__texte">
        <p class="maintenant__heure" data-heure-paris data-suite="@Suite">@LigneHeure</p>

        <h1 id="maintenant-titre" class="maintenant__accroche">@statut.Accroche</h1>

        @if (statut.Lignes.Count > 0)
        {
            <ul class="maintenant__lignes" aria-label="Ce que je fais en ce moment">
                @foreach (var ligne in statut.Lignes)
                {
                    <li>
                        @if (PlanDuSite.Pour(ligne.Rubrique) is { } destination)
                        {
                            <a class="porte" href="@destination.Adresse">
                                <span class="porte__nom">@destination.Libelle</span>
                                <span>@ligne.Texte</span>
                            </a>
                        }
                        else
                        {
                            <span>@ligne.Texte</span>
                        }
                    </li>
                }
            </ul>
        }

        @if (statut.ProchainObjectif is { } objectif)
        {
            <a class="objectif" href="@PlanDuSite.ProjetEnCours.Adresse">
                <span class="objectif__etiquette">Prochain objectif</span>
                <span class="objectif__libelle">@objectif.Libelle</span>
                <span class="objectif__date">@DateObjectif(objectif)</span>
            </a>
        }
    </div>

    <figure class="maintenant__photo">
        @if (string.IsNullOrWhiteSpace(Liens.Value.Instagram))
        {
            <Photo />
        }
        else
        {
            <a href="@Liens.Value.Instagram" aria-label="Voir mes photos sur Instagram"><Photo /></a>
        }
    </figure>
</section>

@code {
    private const string Lieu = "en Bretagne";
    private static readonly string Suite = $" {Lieu}. Voici ce que je fais.";
    private static readonly CultureInfo Francais = CultureInfo.GetCultureInfo("fr-FR");

    private StatutDuMomentDto? statut;

    private string LigneHeure =>
        HeureDeParis.Formater(Horloge.Instant) is { } heure
            ? heure + Suite
            : $"En ce moment, {Lieu}. Voici ce que je fais.";

    protected override async Task OnInitializedAsync() => statut = await Lecteur.LireAsync();

    private static string DateObjectif(ObjectifDto objectif) =>
        objectif.DateCible is { } date ? date.ToString("d MMMM yyyy", Francais) : "Date à confirmer";
}
