<section class="a-cote conteneur" aria-labelledby="a-cote-titre">
    <div class="section-tete">
        <h2 id="a-cote-titre" class="titre-section">@Textes[TextesAccueil.HorsPisteTitre]</h2>
        <a class="vers" href="@PlanDuSite.HorsPiste.Adresse">@Textes[TextesAccueil.HorsPisteLien]</a>
    </div>
    <ul class="a-cote__liste">
        <li>
            <a class="porte a-cote__item" href="@PlanDuSite.HorsPiste.Adresse">
                <span class="porte__nom a-cote__nom">@Textes[TextesAccueil.HorsPiste1Nom]</span>
                <span class="a-cote__description">@Textes[TextesAccueil.HorsPiste1Texte]</span>
            </a>
        </li>
        <li>
            <a class="porte a-cote__item" href="@PlanDuSite.HorsPiste.Adresse">
                <span class="porte__nom a-cote__nom">@Textes[TextesAccueil.HorsPiste2Nom]</span>
                <span class="a-cote__description">@Textes[TextesAccueil.HorsPiste2Texte]</span>
            </a>
        </li>
    </ul>
</section>
